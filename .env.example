# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the deployed ServiceOS app
# Used for booking links, embed snippets and QR codes
NEXT_PUBLIC_APP_URL=

# Deployment environment marker: local | staging | production (default: local)
# staging shows a "TEST ENVIRONMENT" badge and sends noindex (meta + X-Robots-Tag)
NEXT_PUBLIC_APP_ENV=

# Dev server only (empty by default): comma list of LAN hosts allowed to load `next dev`
# (e.g. a phone on the same Wi-Fi). Ignored by `next build`/production.
ALLOWED_DEV_ORIGINS=
