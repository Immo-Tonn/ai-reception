# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the deployed ServiceOS app
# Used for booking links, embed snippets and QR codes
NEXT_PUBLIC_APP_URL=

# Deployment environment marker: local | staging | production (default: local)
# staging shows a "TEST ENVIRONMENT" badge and sends noindex (meta + X-Robots-Tag)
NEXT_PUBLIC_APP_ENV=

# Dev server only (empty by default): comma list of LAN hosts allowed to load `next dev`
# (e.g. a phone on the same Wi-Fi). Ignored by `next build`/production.
ALLOWED_DEV_ORIGINS=

# Google Calendar FreeBusy integration (server-only; never NEXT_PUBLIC_). Leave empty to keep it disabled.
# OAuth client of type "Web application" from Google Cloud Console (see docs/GOOGLE_CALENDAR_SETUP_RU.md)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Encrypts stored refresh tokens. Changing it disconnects everyone.
EXTERNAL_CALENDAR_ENCRYPTION_KEY=

# Vercel Cron: shared secret Vercel sends as "Authorization: Bearer <CRON_SECRET>" (at least 16 chars, random).
# Without it the daily cleanup endpoint stays closed.
CRON_SECRET=
